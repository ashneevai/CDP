# Copy to .env and adjust. No real secrets belong in this file or in .env
# committed to git (.env is gitignored) -- in prod these are injected via
# your secret manager / orchestrator, never baked into images.

# Versioning (part of the document idempotency key)
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1.0

# Database
DATABASE_URL=postgresql+psycopg://idp:idp_dev_password@postgres:5432/idp

# Independently finalized downstream truth. It may share the PostgreSQL server,
# but must not be populated from CDP predictions.
DOWNSTREAM_CLAIMS_DATABASE_URL=postgresql+psycopg://idp:idp_dev_password@postgres:5432/idp
DOWNSTREAM_CLAIMS_TABLE=trusted_finalized_claim_fields
DOWNSTREAM_CLAIMS_SOURCE_SYSTEM=authorized-downstream-claims

# Read-only trusted downstream claims source. MySQL is separate from the
# platform database. Production credentials must come from a secret manager.
# Host execution: mysql+pymysql://holdout_reader:...@localhost:3307/claims_truth
# Compose execution: mysql+pymysql://holdout_reader:...@trusted-claims-mysql:3306/claims_truth
DOWNSTREAM_CLAIMS_DATABASE_URL=
DOWNSTREAM_CLAIMS_TABLE=finalized_claim_fields
DOWNSTREAM_CLAIMS_SOURCE_SYSTEM=authorized-downstream-claims
TRUSTED_CLAIMS_MYSQL_DATABASE=claims_truth
TRUSTED_CLAIMS_MYSQL_ROOT_PASSWORD=change-for-local-development
TRUSTED_CLAIMS_MYSQL_READER_PASSWORD=change-for-local-development

# Object storage (MinIO locally)
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=idp-documents
OBJECT_STORE_USE_SSL=false

# Kafka-compatible bus (Redpanda locally)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
USE_IN_MEMORY_BUS=false

# Redis
REDIS_URL=redis://redis:6379/0

# Ingestion limits
MAX_UPLOAD_SIZE_BYTES=52428800

# VLM -- disabled by default; the pipeline must run end-to-end without it
VLM_ENABLED=false
VLM_ENDPOINT=http://vllm:8001/v1
VLM_MODEL_NAME=qwen2.5-vl-3b-instruct

# External AI gateway: fail-closed defaults. Enable only after tenant PHI,
# region, provider contract and budget approval.
AI_GATEWAY_ENABLED=false
AI_PHI_EXTERNAL_PROCESSING_APPROVED=false
AI_APPROVED_REGIONS=
AI_ALLOWED_MODELS=
AI_DAILY_BUDGET_USD=0
AI_MAX_REQUESTS_PER_MINUTE=0
AI_MAX_CROP_BYTES=2000000
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=1
VERTEX_REGION=us-central1
AWS_TEXTRACT_REGION=us-east-1

# Azure OpenAI crop-only fallback. Keep review-only until a frozen untouched
# holdout passes the production promotion gate. Never commit credentials.
AZURE_AI_EVALUATION_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_AI_EVALUATION_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_REVIEW_ONLY=true

# Closed-world Azure OpenAI adjudication. Pricing must reflect the actual
# subscription/deployment agreement; unset pricing blocks paid authority.
LLM_ENABLED=false
LLM_MODE=SHADOW_ONLY
LLM_PROVIDER=azure_openai
LLM_TARGET_AVG_COST_PER_PAGE_USD=0.0005
LLM_MAX_AVG_COST_PER_PAGE_USD=0.001
LLM_MAX_COST_PER_CLAIM_USD=0.005
LLM_MAX_TIER1_CALLS_PER_PAGE=1
LLM_MAX_TIER2_CALLS_PER_PAGE=1
LLM_TIER1_MAX_INPUT_TOKENS=500
LLM_TIER1_MAX_OUTPUT_TOKENS=40
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
AZURE_OPENAI_INPUT_COST_PER_MILLION=
AZURE_OPENAI_OUTPUT_COST_PER_MILLION=
AZURE_OPENAI_CACHED_INPUT_COST_PER_MILLION=

# Handwritten field-crop OCR -- disabled until the optional ML worker is started
HANDWRITING_ENABLED=false
TROCR_MODEL_NAME=microsoft/trocr-base-handwritten
TROCR_DEVICE=auto
TROCR_MIN_CONFIDENCE=0.55

# Optional PHI-approved cloud handwriting provider. Only unresolved field
# crops are sent; missing credentials never trigger an implicit fallback.
CLOUD_HANDWRITING_ENABLED=false
CLOUD_HANDWRITING_PROVIDER=azure
CLOUD_HANDWRITING_ENDPOINT=
CLOUD_HANDWRITING_CREDENTIAL=
CLOUD_HANDWRITING_TIMEOUT_SECONDS=10

DEFAULT_TENANT_ID=default
